# linear regression
model <- lm(median ~ ribosome_clr$median, data = protein_clr)
slope <- coef(model)[2]
slope_label <- paste0("Slope = ", round(slope, 3))
# add slope coefficient to google sheet
url <- "https://docs.google.com/spreadsheets/d/1DwDgeSOugfCSfyAb6feXC-KmUsX-ejwrghj_iXVWOtg/edit?gid=1566370015#gid=1566370015"
new_row <- data.frame(
Project = project,
Defense_system = ds_type,
Condition = condition_filter,
Slope = slope
)
sheet_append(ss = url, data = new_row, sheet = "ds_vs_rib")
# color palette for time
n <- length(unique(protein_clr$time))
palette_time <- brewer.pal(max(3, n), "Set1")
# Plot
plot <- ggplot(protein_clr, aes(
x = ribosome_clr$median,
y = median,
color = time
)) +
geom_point(size = 5) +
geom_smooth(method = "lm", se = FALSE, color = "black") +
annotate("text",
x = min(median_growth_markers_clr),
y = max(protein_clr$median),
label = slope_label,
hjust = 0, vjust = 1,
size = 5) +
scale_color_manual(values = palette_time) +
labs(
x = "Median Growth Markers CLR",
y = paste0(ds_type, " CLR"),
color = "Time"
) +
theme_minimal()
