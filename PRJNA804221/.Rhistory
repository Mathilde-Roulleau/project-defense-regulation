values_to = "value"
) %>%
group_by(time, condition, rep) %>%
summarise(
median = median(as.numeric(value), na.rm = TRUE),
.groups = "drop"
)
# Filter condition
if (!is.null(condition_filter)) {
protein_clr <- protein_clr %>% filter(condition == condition_filter)
ribosome_clr <- median_growth_markers_clr %>% filter(condition == condition_filter)
}
# linear regression
