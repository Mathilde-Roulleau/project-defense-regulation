y = median,
color = as.factor(time)
)) +
geom_point(size = 5) +
geom_smooth(method = "lm", se = FALSE, color = "black") +
annotate("text",
x = min(median_growth_markers_clr$median),
y = max(protein_clr$median),
label = slope_label,
hjust = 0, vjust = 1,
size = 5) +
scale_color_manual(values = palette_time) +
ylim(-2, 2) +
xlim(-2, 2) +
labs(
x = "Median Growth Markers CLR",
y = paste0(ds_type, " CLR"),
color = "Time"
) +
theme_minimal()
return(plot)
}
