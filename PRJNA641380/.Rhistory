cnt_matrix <- cts[cts$Gene_origin == "Bacteria", ] %>%
# filter bacteria genes
left_join(SRRs, by = "Run") %>%
select(Geneid, condition, counts) %>%
pivot_wider(names_from = condition,
values_from = counts,
values_fill = 0) %>%
as.data.frame()
rownames(cnt_matrix) <- cnt_matrix$Geneid
cnt_matrix <- cnt_matrix[ , -1]
cnt_matrix <- cnt_matrix[, order(names(cnt_matrix))]
cnt_matrix_phage <- cts[cts$Gene_origin == "Phage", ] %>%
# filter phage genes
left_join(SRRs, by = "Run") %>%
select(Geneid, condition, counts) %>%
pivot_wider(names_from = condition,
values_from = counts,
values_fill = 0) %>%
as.data.frame()
rownames(cnt_matrix_phage) <- cnt_matrix_phage$Geneid
cnt_matrix_phage <- cnt_matrix_phage[ , -1]
cnt_matrix_phage <- cnt_matrix_phage[, order(names(cnt_matrix_phage))]
# Compute percentage of detected genes
detected_bacterial_genes <- apply(cnt_matrix, 2, function(x) {
as.numeric(sum(x != 0) / nrow(cnt_matrix) * 100)
})
detected_phage_genes <- apply(cnt_matrix_phage, 2, function(x) {
as.numeric(sum(x != 0) / nrow(cnt_matrix_phage) * 100)
})
mat <- rbind(detected_bacterial_genes, detected_phage_genes)
barplot(mat,
beside = TRUE,
col = c("darkblue", "red"),
ylab = "percentage of detected genes",
ylim = c(0, 100),
las = 2)
legend("bottomright", legend = c("Bacteria", "Phage"),
fill = c("darkblue", "red"))
# Compute percentage of detected genes
detected_bacterial_genes <- apply(cnt_matrix, 2, function(x) {
as.numeric(sum(x != 0) / nrow(cnt_matrix) * 100)
})
detected_phage_genes <- apply(cnt_matrix_phage, 2, function(x) {
as.numeric(sum(x != 0) / nrow(cnt_matrix_phage) * 100)
})
mat <- rbind(detected_bacterial_genes, detected_phage_genes)
barplot(mat,
beside = TRUE,
col = c("darkblue", "red"),
ylab = "percentage of detected genes",
ylim = c(0, 100),
las = 2)
legend("bottomleft", legend = c("Bacteria", "Phage"),
fill = c("darkblue", "red"))
# Add pseudocount to avoid counts = 0
pseudocount <- min(cnt_matrix[cnt_matrix > 0])/10
# Transform the cts_matrix dataframe into a Deseq object
dds_for_vst <- cnt_matrix + pseudocount
dds_for_vst <- DESeqDataSetFromMatrix(round(dds_for_vst), as.data.frame(colnames(dds_for_vst)), design = ~ 1)
# Apply a variance stabilizing transformation (VST) to the count data
vst <- varianceStabilizingTransformation(dds_for_vst) %>%
assay() %>%
as.data.frame()
vst <- 2^(vst)
# Normalization by gene length
genes_length <- cts[match(intersect(rownames(vst), cts$Geneid), cts$Geneid), ]$Length
vst <- vst/(genes_length * 10^(-3))
# Centered Log2 Ratio (CLR)
clr <- log2(vst / exp(rowMeans(log(vst))))
# Construction of a distance matrix for PCoA
dist_matrix_clr <- vegdist(t(clr), method = "euclidean")
# Compute principal coordinate decomposition
pcoa_clr <- pcoa(dist_matrix_clr)
# Plot PCoA2 vs PCoA2
pcoa_df_clr <- data.frame(
condition = rownames(pcoa_clr$vectors),
Axis1 = pcoa_clr$vectors[, 1],
Axis2 = pcoa_clr$vectors[, 2]
)
pcoa_df_clr <- left_join(pcoa_df_clr, SRRs, by = "condition")
ggplot(pcoa_df_clr, aes(x = Axis1, y = Axis2, color = Time, label = Time)) +
geom_point(size = 4) +
geom_text(vjust = -0.8, size = 3.5, color = "black") +
theme_minimal() +
labs(
x = paste0("PCoA 1 (", round(pcoa_clr$values$Relative_eig[1] * 100, 1), "%)"),
y = paste0("PCoA 2 (", round(pcoa_clr$values$Relative_eig[2] * 100, 1), "%)"),
color = "Condition")
