source("../load_files.R")
SRRs <- SRRs %>%
mutate(State = ifelse(str_detect(Library.Name, "P"), "infected", "control"),
condition = str_remove_all(Library.Name, "[TP]")) %>%
separate(condition, into = c("Time", "rep"), sep = "-", remove = FALSE) %>%
mutate(condition = paste0(Time, "_", State, "_", rep))
# Create count matrixes for all genes + bacterial genes+ phage genes
source("../count_matrices.R")
# Quality control steps
source("../qc_steps.R")
growth_markers_genes <- c("rplV", "rplD", "rplC", "rpsC", "rpsS", "rplB", "rplP", "rplE", "rplX", "rimM", "rplF", "rplN", "rpsH", "rpsE", "rpsQ", "rplR", "rpsD", "secY", "rplQ", "rplO", "rpsM", "rpoA", "rpsK", "rplA", "rplK", "rplM", "rplJ", "pnp", "mnmC", "rpsG", "tig", "nusG", "tsf", "rpsI", "truB", "purB", "gyrA", "rbfA", "spoU", "rpsB")
growth_markers_proteins <- bacterial_genome[bacterial_genome$gene %in% growth_markers_genes, ]$protein_id
growth_markers_proteins <- growth_markers_proteins[!is.na(growth_markers_proteins)]
# Add pseudocount to avoid counts = 0
pseudocount <- min(cnt_matrix[cnt_matrix > 0])/10
# Transform the cts_matrix dataframe into a Deseq object
dds_for_vst <- cnt_matrix + pseudocount
dds_for_vst <- DESeqDataSetFromMatrix(round(dds_for_vst), as.data.frame(colnames(dds_for_vst)), design = ~ 1)
# Apply a variance stabilizing transformation (VST) to the count data
vst <- varianceStabilizingTransformation(dds_for_vst) %>%
assay() %>%
as.data.frame()
vst <- 2^(vst)
# Normalization by gene length
genes_length <- cts[match(intersect(rownames(vst), cts$Geneid), cts$Geneid), ]$Length
vst <- vst/(genes_length * 10^(-3))
# Centered Log2 Ratio (CLR)
clr <- log2(vst / exp(rowMeans(log(vst))))
# Construction of a distance matrix for PCoA
dist_matrix_clr <- vegdist(t(clr), method = "euclidean")
# Compute principal coordinate decomposition
pcoa_clr <- pcoa(dist_matrix_clr)
# Plot PCoA2 vs PCoA2
pcoa_df_clr <- data.frame(
condition = rownames(pcoa_clr$vectors),
Axis1 = pcoa_clr$vectors[, 1],
Axis2 = pcoa_clr$vectors[, 2]
)
pcoa_df_clr <- left_join(pcoa_df_clr, SRRs, by = "condition")
pcoa_df_clr <- pcoa_df_clr %>%
mutate(label = paste0(ifelse(State == "infected", "I", "C"), " ", Time))
ggplot(pcoa_df_clr, aes(x = Axis1, y = Axis2, color = State, label = label)) +
geom_point(size = 4) +
geom_text(vjust = -0.8, size = 3.5, color = "black") +
scale_color_manual(
values = c("infected" = "red",
"control" = "darkblue")
) +
theme_minimal() +
labs(
x = paste0("PCoA 1 (", round(pcoa_clr$values$Relative_eig[1] * 100, 1), "%)"),
y = paste0("PCoA 2 (", round(pcoa_clr$values$Relative_eig[2] * 100, 1), "%)"),
color = "Condition")
growth_markers_clr <- clr[growth_markers_proteins, ]
median_growth_markers_clr <- growth_markers_clr %>%
(function(x) apply(x, 2, median)) %>%
as.data.frame() %>%
rownames_to_column("time_condition_rep") %>%
separate(time_condition_rep, into = c("time", "condition","rep"), sep = "_") %>%
mutate(time = as.numeric(time)) %>%
pivot_longer(
cols = -c(time, condition, rep),
names_to = "protein",
values_to = "value"
) %>%
group_by(time, condition, rep) %>%
summarise(
median = median(as.numeric(value), na.rm = TRUE),
.groups = "drop"
)
# The gene ID from Genomad and from count matrix are not the same...
struct_phage_clr <- clr[unique(cts[cts$Gene_origin == "Phage" & cts$Start %in% structural_phage_genes$start, ]$Geneid), ]
median_struct_phage_clr <- struct_phage_clr %>%
(function(x) apply(x, 2, median)) %>%
as.data.frame() %>%
rownames_to_column("time_condition_rep") %>%
separate(time_condition_rep, into = c("time", "condition","rep"), sep = "_") %>%
mutate(time = as.numeric(time)) %>%
pivot_longer(
cols = -c(time, condition, rep),
names_to = "protein",
values_to = "value"
) %>%
group_by(time, condition, rep) %>%
summarise(
median = median(as.numeric(value), na.rm = TRUE),
.groups = "drop"
)
