plots <- list()
for (ds_ in unique(ds$type)) {
proteins <- ds %>% filter(type == ds_) %>% pull(protein_in_syst)
plots[[ds_]] <- plot_ds_vs_growth(proteins, ds_, median_growth_markers_clr, "ribosome genes")
}
