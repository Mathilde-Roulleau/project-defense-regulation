# Define the root folder
root_folder <- "C:/Users/mathi/OneDrive - epfl.ch/project-defense-regulation"
# Function to check if a folder is empty
is_empty_folder <- function(folder) {
length(list.files(folder, all.files = TRUE, no.. = TRUE)) == 0
}
# Recursively get all subfolders (deepest first)
all_folders <- list.dirs(root_folder, recursive = TRUE, full.names = TRUE)
# Sort by descending path length to delete deepest folders first
all_folders <- all_folders[order(nchar(all_folders), decreasing = TRUE)]
# Loop through folders and delete if empty
for (folder in all_folders) {
if (is_empty_folder(folder)) {
unlink(folder, recursive = TRUE)
cat("Deleted:", folder, "\n")
}
}
