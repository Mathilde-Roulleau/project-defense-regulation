ggsave("C:/Users/mathi/OneDrive - epfl.ch/project-defense-regulation/heatmap_corr_strength.pdf", height = 200, width = 200, unit = "mm")
# Préparer un index pour l'empilement
correlation_df <- correlation_df %>%
group_by(Project) %>%
arrange(Project) %>%
mutate(tile_order = row_number()) %>%  # position verticale pour stack
ungroup()
# Palette de couleurs
colors <- brewer.pal(9, "RdYlBu")  # adapter à tes catégories
# Plot stacked tiles
heatmap_stack <- ggplot(correlation_df, aes(x = Project, y = tile_order, fill = Corr_phage_strength)) +
geom_tile(width = 0.9, height = 0.9, color = "white") +  # rectangles empilés
geom_text(aes(label = Defense_system), size = 2, color = "black") + # texte à l'intérieur
scale_fill_manual(values = colors, name = "Phage correlation strength") +
scale_y_reverse() +   # optionnel : pour que le premier défense system soit en haut
theme_minimal() +
theme(
axis.title = element_blank(),
axis.text.y = element_blank(),    # supprime les labels sur l'axe y
axis.ticks.y = element_blank(),
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1, size = 7),
panel.grid = element_blank(),
legend.position = "right",
legend.text = element_text(size = 7),
legend.title = element_text(size = 9, face = "bold"),
legend.key.size = unit(0.5, "cm")
)
ggsave("C:/Users/mathi/OneDrive - epfl.ch/project-defense-regulation/heatmap_corr_strength.pdf", height = 200, width = 200, unit = "mm")
