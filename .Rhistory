mutate(time_rep = str_remove_all(time_rep, " min")) %>%
separate(time_rep, into = c("time", "rep"), sep = "_") %>%
mutate(time = as.numeric(time))
# compute mean and se
median_clr <- protein_clr %>%
group_by(time) %>%
summarise(
median = median(value, na.rm = TRUE),
q1 = quantile(value, 0.25, na.rm = TRUE),
q3 = quantile(value, 0.75, na.rm = TRUE)
)
# Plot
ggplot(median_clr, aes(aes(x = time, y = median))) +
geom_errorbar(aes(ymin = q1, ymax = q3)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
theme_minimal() +
ylim(-0.6, 0.8) +
labs(
title = paste("Defense system = ", ds_type),
x = "Time post infection (min)",
y = "CLR"
)
}
