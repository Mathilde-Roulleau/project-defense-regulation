# load metadata
SRRs <- read.csv("metadata.csv", header = TRUE)
SRRs <- SRRs %>%
mutate(State = ifelse(str_detect(Library.Name, "P"), "infected", "control"),
time_rep = str_remove_all(Library.Name, "[B_P+]")) %>%
separate(time_rep, into = c("time", "rep"), sep = "-", remove = FALSE)
View(SRRs)
# load metadata
SRRs <- read.csv("metadata.csv", header = TRUE)
SRRs <- SRRs %>%
rename(stage_of_infection = time)
