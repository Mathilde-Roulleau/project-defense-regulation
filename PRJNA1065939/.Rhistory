)
}
plots <- list()
#plot_CLR(ds %>% filter(type == "RM") %>% pull(protein_in_syst), "RM")
for (ds_ in unique(ds$type)) {
proteins <- ds %>% filter(type == ds_) %>% pull(protein_in_syst)
plots[[ds_]] <- plot_CLR(proteins, ds_)
}
wrap_plots(plots, ncol = 4)
plot_CLR <- function(protein, ds_type) {
protein_clr <- clr[protein, , drop = FALSE]
protein_clr <- protein_clr %>%
t() %>%
as.data.frame() %>%
rownames_to_column("time_State_rep") %>%
separate(time_State_rep, into = c("time", "State", "rep"), sep = "_") %>%
mutate(time = as.numeric(time)) %>%
pivot_longer(
cols = -c(time, State, rep),   # toutes les colonnes protéines
names_to = "protein",
values_to = "value"
) %>%
group_by(time) %>%
summarise(
median = median(value, na.rm = TRUE),
sd     = sd(value, na.rm = TRUE),
.groups = "drop"
)
# Plot
ggplot(protein_clr, aes(x = time, y = median)) +
geom_errorbar(aes(ymin = median-sd, ymax = median+sd)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
theme_minimal() +
ylim(-1.2, 1) +
labs(
title = paste("Defense system = ", ds_type),
x = "Time post infection (min)",
y = "median CLR"
)
}
