projDir <- file.path(baseDir, proj)
if (!dir.exists(projDir)) {
warning(paste("Directory", projDir, "not found, skipping..."))
next
}
setwd(projDir)
system2("Rscript", rScript)
cat("Finished project:", proj, "\n")
}
