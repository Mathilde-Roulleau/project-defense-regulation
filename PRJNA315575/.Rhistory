library("DESeq2")
library(dplyr)
library(stringr)
library(apeglm)
library(ggplot2)
library("EnhancedVolcano")
library("tidyr")
library(edgeR)
library(patchwork)
library(Biostrings)
library("seqinr")
library(vegan)
library(ape)
library(tibble)
library(patchwork)
library(readr)
project <- "PRJNA315575"
# load metadata
SRRs <- read.csv("metadata.csv", header = TRUE)
SRRs <- SRRs %>%
mutate(condition = paste0(timepoint, "_", control_or_infected, "_", light_or_dark, "_", replicate)) %>%
mutate(timepoint = as.numeric(timepoint))
# load gene counts for each run
cts <- read.table("../counts_batch2.tsv", header = TRUE)
names(cts)[names(cts) == "run_accession"] <- "Run"
# select runs and classify gene origin
bacterial_genome <- read.gff("genomic.gff")
bacterial_genome <- bacterial_genome %>%
separate_rows(attributes, sep = ";") %>%
separate(attributes, into = c("key", "value"), sep = "=", fill = "right") %>%
pivot_wider(names_from = key, values_from = value)
cts <- cts %>%
filter(Run %in% SRRs$Run) %>%
mutate(Gene_origin = ifelse(
sapply(Chr, function(x){
any(strsplit(x, ";")[[1]] %in% bacterial_genome$seqid)
}),
"Bacteria",
"Phage"
))
cts$Geneid <- sub("^cds-", "", cts$Geneid)
cts$Geneid <- sub("^rna-", "", cts$Geneid)
# load defense systems of the bacteria obtained from defense finder
ds <- read.csv("defense_systems.csv", header = TRUE)[, c("Geneid", "protein_in_syst", "type")]
# recover phage accession (gcf) from google sheet
phage_accession <- read_sheet("https://docs.google.com/spreadsheets/d/1DwDgeSOugfCSfyAb6feXC-KmUsX-ejwrghj_iXVWOtg/edit?gid=1293325500#gid=1293325500", sheet = "GCF_list")
source(../load_packages.R)
source("../load_packages.R")
