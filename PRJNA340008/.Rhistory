library("DESeq2")
library(dplyr)
library(stringr)
library(apeglm)
library(ggplot2)
library("EnhancedVolcano")
library("tidyr")
library(edgeR)
library(patchwork)
library(Biostrings)
library("seqinr")
library(vegan)
library(ape)
library(tibble)
library(patchwork)
library(readr)
# load metadata
SRRs <- read.csv("metadata.csv", header = TRUE)
SRRs <- SRRs %>%
mutate(Time = str_remove_all(Time_point, " min post infection"))%>%
mutate(Time = as.numeric(Time))%>%
group_by(Time) %>%
mutate(rep = row_number()) %>%
ungroup() %>%
mutate(condition = paste0(Time, "_", rep))
# load gene counts for each run
cts <- read.table("../counts_batch2.tsv", header = TRUE)
names(cts)[names(cts) == "run_accession"] <- "Run"
# select runs and classify gene origin
bacterial_genome <- read.gff("genomic.gff")
cts <- cts %>%
filter(Run %in% SRRs$Run) %>%
mutate(Gene_origin = ifelse(
sapply(Chr, function(x){
any(strsplit(x, ";")[[1]] %in% bacterial_genome$seqid)
}),
"Bacteria",
"Phage"
))
cts$Geneid <- sub("^cds-", "", cts$Geneid)
cts$Geneid <- sub("^rna-", "", cts$Geneid)
# load defense systems of the bacteria obtained from defense finder
ds <- read.csv("defense_systems.csv", header = TRUE)[, c("Geneid", "protein_in_syst", "type")]
# load metadata
SRRs <- read.csv("metadata.csv", header = TRUE)
SRRs <- SRRs %>%
mutate(State = ifelse(str_detect(strain, "P4"), "infected", "control"),
Time = as.numeric(str_remove_all(Time_point, " min post infection")))
SRRs <- SRRs %>%
group_by(Time, State) %>%
mutate(rep = row_number()) %>%
ungroup() %>%
mutate(condition = paste0(Time, "_", State, "_", rep))
# load gene counts for each run
cts <- read.table("../counts_batch2.tsv", header = TRUE)
names(cts)[names(cts) == "run_accession"] <- "Run"
# select runs and classify gene origin
bacterial_genome <- read.gff("genomic.gff")
cts <- cts %>%
filter(Run %in% SRRs$Run) %>%
mutate(Gene_origin = ifelse(
sapply(Chr, function(x){
any(strsplit(x, ";")[[1]] %in% bacterial_genome$seqid)
}),
"Bacteria",
"Phage"
))
cts$Geneid <- sub("^cds-", "", cts$Geneid)
cts$Geneid <- sub("^rna-", "", cts$Geneid)
# load defense systems of the bacteria obtained from defense finder
ds <- read.csv("defense_systems.csv", header = TRUE)[, c("Geneid", "protein_in_syst", "type")]
# Number of bacterial and phage gene counts per run
cts_per_run_b_p <- cts %>%
left_join(SRRs, by = "Run") # join with SRR to get the condition to label
cts_per_run_b_p <- cts_per_run_b_p %>%
group_by(condition, Gene_origin) %>%
summarise(counts = sum(counts), .groups = "drop") %>%
as.data.frame()
colnames(cts_per_run_b_p)[colnames(cts_per_run_b_p) == "Library.Name"] <- "Run"
# Plots bacteria and phage gene counts per run
ggplot(cts_per_run_b_p, aes(x = condition, y = counts, fill = Gene_origin)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8)) +
scale_fill_manual(values = c("Phage" = "red", "Bacteria" = "darkblue")) +
theme_minimal() +
labs(
x = "Run",
y = "# reads",
fill = "Gene origin"
) +
theme(
axis.text.x = element_text(angle = 90)
)
View(cts_per_run_b_p)
cnt_matrix <- cts %>%
left_join(SRRs, by = "Run") %>%
select(Geneid, condition, counts) %>%
pivot_wider(names_from = condition,
values_from = counts,
values_fill = 0) %>%
as.data.frame()
rownames(cnt_matrix) <- cnt_matrix$Geneid
cnt_matrix <- cnt_matrix[ , -1]
cnt_matrix <- cnt_matrix[, order(names(cnt_matrix))]
cnt_matrix_bacteria <- cts[cts$Gene_origin == "Bacteria", ] %>%
# filter bacteria genes
left_join(SRRs, by = "Run") %>%
select(Geneid, condition, counts) %>%
pivot_wider(names_from = condition,
values_from = counts,
values_fill = 0) %>%
as.data.frame()
rownames(cnt_matrix_bacteria) <- cnt_matrix_bacteria$Geneid
cnt_matrix_bacteria <- cnt_matrix_bacteria[ , -1]
cnt_matrix_bacteria <- cnt_matrix_bacteria[, order(names(cnt_matrix_bacteria))]
cnt_matrix_phage <- cts[cts$Gene_origin == "Phage", ] %>%
# filter phage genes
left_join(SRRs, by = "Run") %>%
select(Geneid, condition, counts) %>%
pivot_wider(names_from = condition,
values_from = counts,
values_fill = 0) %>%
as.data.frame()
rownames(cnt_matrix_phage) <- cnt_matrix_phage$Geneid
cnt_matrix_phage <- cnt_matrix_phage[ , -1]
cnt_matrix_phage <- cnt_matrix_phage[, order(names(cnt_matrix_phage))]
# Compute percentage of detected genes
detected_bacterial_genes <- apply(cnt_matrix_bacteria, 2, function(x) {
as.numeric(sum(x != 0) / nrow(cnt_matrix_bacteria) * 100)
})
detected_phage_genes <- apply(cnt_matrix_phage, 2, function(x) {
as.numeric(sum(x != 0) / nrow(cnt_matrix_phage) * 100)
})
mat <- rbind(detected_bacterial_genes, detected_phage_genes)
barplot(mat,
beside = TRUE,
col = c("darkblue", "red"),
ylab = "percentage of detected genes",
ylim = c(0, 100),
las = 2)
legend("bottomright", legend = c("Bacteria", "Phage"),
fill = c("darkblue", "red"))
# Add pseudocount to avoid counts = 0
pseudocount <- min(cnt_matrix[cnt_matrix > 0])/10
# Transform the cts_matrix dataframe into a Deseq object
dds_for_vst <- cnt_matrix + pseudocount
dds_for_vst <- DESeqDataSetFromMatrix(round(dds_for_vst), as.data.frame(colnames(dds_for_vst)), design = ~ 1)
# Apply a variance stabilizing transformation (VST) to the count data
vst <- varianceStabilizingTransformation(dds_for_vst) %>%
assay() %>%
as.data.frame()
vst <- 2^(vst)
# Normalization by gene length
genes_length <- cts[match(intersect(rownames(vst), cts$Geneid), cts$Geneid), ]$Length
vst <- vst/(genes_length * 10^(-3))
# Centered Log2 Ratio (CLR)
clr <- log2(vst / exp(rowMeans(log(vst))))
# Construction of a distance matrix for PCoA
dist_matrix_clr <- vegdist(t(clr), method = "euclidean")
# Compute principal coordinate decomposition
pcoa_clr <- pcoa(dist_matrix_clr)
# Plot PCoA2 vs PCoA2
pcoa_df_clr <- data.frame(
condition = rownames(pcoa_clr$vectors),
Axis1 = pcoa_clr$vectors[, 1],
Axis2 = pcoa_clr$vectors[, 2]
)
pcoa_df_clr <- left_join(pcoa_df_clr, SRRs, by = "condition")
ggplot(pcoa_df_clr, aes(x = Axis1, y = Axis2, color = Time, label = Time)) +
geom_point(size = 4) +
geom_text(vjust = -0.8, size = 3.5, color = "black") +
theme_minimal() +
labs(
x = paste0("PCoA 1 (", round(pcoa_clr$values$Relative_eig[1] * 100, 1), "%)"),
y = paste0("PCoA 2 (", round(pcoa_clr$values$Relative_eig[2] * 100, 1), "%)"),
color = "Condition")
cnt_matrix <- cnt_matrix[, -c("13_control_1", "13_control_2", "13_control_3")]
cnt_matrix <- cnt_matrix[, setdiff(colnames(cnt_matrix),
c("13_control_1", "13_control_2", "13_control_3"))]
# remove them because they are as "control" in the metadata but have same profile as infected
cnt_matrix <- cnt_matrix[, setdiff(colnames(cnt_matrix),
c("13_control_1", "13_control_2", "13_control_3"))]
clr <- clr[, setdiff(colnames(cnt_matrix),
c("13_control_1", "13_control_2", "13_control_3"))]
plot_CLR <- function(protein, ds_type) {
protein_clr <- clr[protein, , drop = FALSE]
protein_clr <- protein_clr %>%
t() %>%
as.data.frame() %>%
rownames_to_column("time_rep") %>%
separate(time_rep, into = c("time", "rep"), sep = "h_") %>%
mutate(time = as.numeric(time)) %>%
pivot_longer(
cols = -c(time, rep),
names_to = "protein",
values_to = "value"
) %>%
group_by(time) %>%
summarise(
median = median(value, na.rm = TRUE),
sd     = sd(value, na.rm = TRUE),
.groups = "drop"
)
# Plot
ggplot(protein_clr, aes(x = time, y = median)) +
geom_errorbar(aes(ymin = median-sd, ymax = median+sd)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
theme_minimal() +
ylim(-1, 1) +
labs(
title = paste("Defense system = ", ds_type),
x = "Time post infection (min)",
y = "median CLR"
) +
theme(
plot.title = element_text(size = 15, face = "bold"),
axis.title.x = element_text(size = 15),
axis.title.y = element_text(size = 15),
axis.text.x = element_text(size = 16),
axis.text.y = element_text(size = 16)
)
}
plot_CLR <- function(protein, ds_type) {
protein_clr <- clr[protein, , drop = FALSE]
protein_clr <- protein_clr %>%
t() %>%
as.data.frame() %>%
rownames_to_column("time_state_rep") %>%
separate(time_rep, into = c("time", "state", "rep"), sep = "_") %>%
mutate(time = as.numeric(time)) %>%
pivot_longer(
cols = -c(time, state, rep),
names_to = "protein",
values_to = "value"
) %>%
group_by(time) %>%
summarise(
median = median(value, na.rm = TRUE),
sd     = sd(value, na.rm = TRUE),
.groups = "drop"
)
# Plot
ggplot(protein_clr, aes(x = time, y = median)) +
geom_errorbar(aes(ymin = median-sd, ymax = median+sd)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
theme_minimal() +
ylim(-1, 1) +
labs(
title = paste("Defense system = ", ds_type),
x = "Time post infection (min)",
y = "median CLR"
) +
theme(
plot.title = element_text(size = 15, face = "bold"),
axis.title.x = element_text(size = 15),
axis.title.y = element_text(size = 15),
axis.text.x = element_text(size = 16),
axis.text.y = element_text(size = 16)
)
}
plots <- list()
for (ds_ in unique(ds$type)) {
proteins <- ds %>% filter(type == ds_) %>% pull(protein_in_syst)
plots[[ds_]] <- plot_CLR(proteins, ds_)
}
